---
/**
 * ToolMatrix: tools against projects. A dot means the tool is in that project's
 * code or pipeline, as described on its page. Click a project to light up its
 * tools. Tools with no dot are listed below as "used, no project page yet".
 */
const cols = ['Franco', 'Sofara', 'Tourasna', 'Code quality'];
const hrefs = ['/projects/franco/', '/projects/sofara/', '/projects/tourasna/', '/projects/code-quality/'];
const groups: { name: string; rows: [string, number[]][] }[] = [
  {
    name: 'Machine learning',
    rows: [
      ['PyTorch', [2]],
      ['YOLOv8', [2]],
      ['ONNX Runtime', [0]],
      ['scikit-learn', [3]],
      ['XGBoost', [3]],
      ['Keras', [3]],
      ['SentencePiece', [2]],
    ],
  },
  {
    name: 'Data',
    rows: [
      ['Power BI', [0, 1, 2, 3]],
      ['pandas', [3]],
      ['SQLite', [1]],
      ['Statistics (Wilson, split score)', [1]],
      ['pylint and radon', [3]],
    ],
  },
  {
    name: 'Engineering',
    rows: [
      ['Python', [0, 1, 2, 3]],
      ['FastAPI', [2]],
      ['Flutter and Dart', [0, 2]],
      ['GitHub Actions', [1]],
    ],
  },
];
const also = ['TensorFlow', 'Hugging Face', 'EfficientNet', 'NumPy', 'Matplotlib', 'Seaborn', 'NLTK', 'Stanza', 'SQL', 'Kotlin', 'C++', 'Git', 'Docker', 'Google Cloud'];
---

<div class="matrix" data-matrix>
  <div class="head">
    <span></span>
    {cols.map((c, i) => <button type="button" data-col={i} aria-pressed="false">{c}</button>)}
  </div>
  {groups.map((g) => (
    <div class="grp">
      <p class="gn">{g.name}</p>
      {g.rows.map(([name, used]) => (
        <div class="row" data-used={used.join(',')}>
          <span class="t">{name}</span>
          {cols.map((c, i) => (
            <span class="cell">{used.includes(i) ? <a href={hrefs[i]} aria-label={`${name} in ${c}`}><i></i></a> : null}</span>
          ))}
        </div>
      ))}
    </div>
  ))}
  <p class="also"><strong>Also used</strong> in coursework and team work, no project page yet: {also.join(', ')}.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-matrix]').forEach((m) => {
    const btns = [...m.querySelectorAll<HTMLButtonElement>('.head button')];
    const rows = [...m.querySelectorAll<HTMLElement>('.row')];
    let on = -1;
    const apply = () => {
      rows.forEach((r) => {
        const used = r.dataset.used!.split(',').map(Number);
        r.classList.toggle('dim', on >= 0 && !used.includes(on));
      });
      btns.forEach((b, i) => b.setAttribute('aria-pressed', String(i === on)));
    };
    btns.forEach((b, i) =>
      b.addEventListener('click', () => {
        on = on === i ? -1 : i;
        apply();
      }),
    );
  });
</script>

<style>
  .matrix { max-width: 760px; overflow-x: auto; }
  .head, .row { display: grid; grid-template-columns: minmax(170px, 1.6fr) repeat(4, minmax(78px, 1fr)); align-items: center; min-width: 560px; }
  .head button {
    font: inherit; font-size: 14px; color: var(--ink); background: none; border: 0;
    border-bottom: 2px solid var(--rule); padding: 8px 4px; cursor: pointer;
  }
  .head button:hover, .head button:focus-visible { border-color: var(--teal); }
  .head button[aria-pressed='true'] { background: var(--teal); color: #0d0f10; border-color: var(--teal); }
  .gn { margin: 22px 0 4px; font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-soft); }
  .row { border-bottom: 1px solid var(--rule); min-height: 38px; transition: opacity 0.2s, background 0.2s; }
  .row:hover { background: var(--panel); }
  .row.dim { opacity: 0.2; }
  .t { font-size: 16px; }
  .cell { display: grid; place-items: center; }
  .cell a { display: grid; place-items: center; width: 30px; height: 30px; }
  .cell i { width: 12px; height: 12px; background: var(--teal); border-radius: 50%; transition: transform 0.2s; }
  .cell a:hover i, .cell a:focus-visible i { transform: scale(1.7); }
  .also { margin: 22px 0 0; color: var(--ink-soft); font-size: 15px; max-width: 62ch; }
  .also strong { color: var(--ink); }
</style>
