---
/**
 * Brand icons. Paths for GitHub, Google Play and Gmail come from the simple-icons
 * package (CC0). LinkedIn is not in that package any more, so it is drawn here
 * as plain geometry: a rounded square with "in".
 */
import { siGithub, siGoogleplay, siGmail, siKaggle } from 'simple-icons';
interface Props {
  name: 'github' | 'linkedin' | 'play' | 'mail' | 'kaggle';
  size?: number;
}
const { name, size = 20 } = Astro.props;
const paths = { github: siGithub.path, play: siGoogleplay.path, mail: siGmail.path, kaggle: siKaggle.path } as const;
---

{
  name === 'linkedin' ? (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" d="M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1.6 6.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4ZM4 9.5V19h3.2V9.5H4Zm5 0V19h3.1v-4.9c0-1.3.5-2.2 1.7-2.2 1.1 0 1.5.8 1.5 2.1V19H18.5v-5.6c0-2.6-1.4-3.9-3.4-3.9-1.5 0-2.5.8-2.9 1.5h-.1V9.5H9Z" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false">
      <path d={paths[name]} />
    </svg>
  )
}
