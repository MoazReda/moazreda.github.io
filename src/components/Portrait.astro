---
/**
 * Portrait: a transparent cut-out that "resolves" from coarse blocks to sharp,
 * once, when it enters view (design.md, Motion #3). Used twice on the home page.
 */
interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  max?: number;
  caption?: string;
  eager?: boolean;
}
const { src, width, height, alt, max = 340, caption, eager = false } = Astro.props;
---

<figure class="portrait" data-portrait style={`--max:${max}px; aspect-ratio:${width}/${height}`}>
  <span class="frame" aria-hidden="true"></span>
  <img src={src} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} />
  <canvas aria-hidden="true"></canvas>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-portrait]').forEach((fig) => {
    if (reduce) return;
    fig.classList.add('armed');
    const img = fig.querySelector('img')!;
    const cv = fig.querySelector('canvas')!;
    const run = () => {
      const w = (cv.width = img.naturalWidth || 400);
      const h = (cv.height = img.naturalHeight || 400);
      const ctx = cv.getContext('2d')!;
      const small = document.createElement('canvas');
      const sctx = small.getContext('2d')!;
      const sizes = [48, 32, 20, 12, 7, 4, 2, 1];
      const t0 = performance.now();
      const dur = 1200;
      fig.classList.add('running');
      const frame = (t: number) => {
        ctx.clearRect(0, 0, w, h);
        const k = Math.max(0, Math.min(1, (t - t0) / dur));
        const b = sizes[Math.min(sizes.length - 1, Math.floor(k * sizes.length))];
        small.width = Math.max(1, Math.round(w / (b * 3)));
        small.height = Math.max(1, Math.round(h / (b * 3)));
        sctx.clearRect(0, 0, small.width, small.height);
        sctx.drawImage(img, 0, 0, small.width, small.height);
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(small, 0, 0, w, h);
        if (k < 1) requestAnimationFrame(frame);
        else fig.classList.remove('running', 'armed');
      };
      requestAnimationFrame(frame);
    };
    const io = new IntersectionObserver((es) => {
      if (es[0].isIntersecting) {
        io.disconnect();
        if (img.complete) run();
        else img.addEventListener('load', run, { once: true });
      }
    });
    io.observe(fig);
  });
</script>

<style>
  /* The frame is the box; the cut-out is clipped to it at rest and steps out of it on hover. */
  .portrait {
    margin: 0;
    position: relative;
    width: 100%;
    max-width: var(--max);
  }
  .frame {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 40%, #1f2a2c 0%, var(--panel) 65%);
    border: 1px solid var(--rule);
    transition: border-color 0.3s;
  }
  img,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transform-origin: 50% 100%;
    clip-path: inset(0);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), clip-path 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.45s;
  }
  canvas {
    display: none;
  }
  .running canvas {
    display: block;
  }
  .armed img {
    visibility: hidden;
  }
  @media (hover: hover) {
    .portrait:hover .frame {
      border-color: var(--teal);
    }
    .portrait:hover img {
      transform: scale(1.14) translateY(-3%);
      clip-path: inset(-40% -25% 0 -25%);
      filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.55));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    img, canvas, .frame { transition: none; }
  }
  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 24px 12px 8px;
    font-size: 13px;
    color: var(--ink-soft);
    background: linear-gradient(transparent, rgba(13, 15, 16, 0.85));
  }
</style>
